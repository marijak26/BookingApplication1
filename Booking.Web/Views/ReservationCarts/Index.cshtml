@model Booking.Domain.DTO.ReservationCartDTO

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Your Reservation Cart</h2>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Nights</th>
        <th>Price</th>
        <th></th>
    </tr>
    @foreach (var item in Model.Accommodations)
    {
        <tr>
            <td>@item.Accommodation.Name</td>
            <td>@item.Nights</td>
            <td>@(item.Nights* item.Accommodation.PricePerNight)</td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Remove</a>
            </td>
        </tr>
    }
</table>

<h3>Total: @Model.TotalPrice</h3>

@if (Model.Accommodations != null && Model.Accommodations.Any())
{
    <a asp-action="Confirm" class="btn btn-success">Confirm Reservation</a>
    <a asp-action="Cancel" class="btn btn-warning">Cancel Reservation</a>
}