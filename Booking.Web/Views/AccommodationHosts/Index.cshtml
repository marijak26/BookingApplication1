@model IEnumerable<Booking.Domain.DomainModels.AccommodationHost>

@{
    ViewData["Title"] = "Accommodation Hosts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Accommodation Hosts</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                Create New
            </a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.FullName</h5>

                        <p class="card-text mb-1">
                            <strong>Email:</strong> @item.ContactEmail
                        </p>

                        <p class="card-text mb-1">
                            <strong>Country:</strong> @item.Country?.Name
                        </p>

                        <p class="card-text mb-3">
                            <strong>City:</strong> @item.City?.Name
                        </p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Details</a>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <p>No accommodation hosts found.</p>
    }
</div>
