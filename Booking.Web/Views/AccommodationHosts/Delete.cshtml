@model Booking.Domain.DomainModels.AccommodationHost

@{
    ViewData["Title"] = "Delete Accommodation Host";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Delete Accommodation Host</h1>

<h3>Are you sure you want to delete this?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.FullName)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.FullName)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ContactEmail)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.ContactEmail)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Country)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Country.Name)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.City)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.City.Name)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
</form>
