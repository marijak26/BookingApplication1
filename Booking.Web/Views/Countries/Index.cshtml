@model IEnumerable<Booking.Domain.DomainModels.Country>

<h2>Countries</h2>

<a asp-action="Import" class="btn btn-primary mb-3">
    Import Countries from API
</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var country in Model.OrderBy(c => c.Name))
        {
            <tr>
                <td>@country.Name</td>
            </tr>
        }
    </tbody>
</table>
