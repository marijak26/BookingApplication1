@model Booking.Domain.DomainModels.Accommodation

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div class="card mb-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.ImageUrl" class="img-fluid rounded-start" alt="@Model.Name" />
        </div>

        <div class="col-md-6">
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <p class="card-text">@Model.Description</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Price per Night</dt>
                    <dd class="col-sm-8">@String.Format("{0} €", Model.PricePerNight)</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(m => m.Category)</dd>

                    <dt class="col-sm-4">Host</dt>
                    <dd class="col-sm-8">@Model.Host?.FullName</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
    }
    <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
</div>
