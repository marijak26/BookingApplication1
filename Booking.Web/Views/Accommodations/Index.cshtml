@model IEnumerable<Booking.Domain.DomainModels.Accommodation>

@{
    ViewData["Title"] = "Accommodations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-section">
    <div class="hero-content">
        <h1>Find your perfect stay</h1>
        <p>Hotels, apartments, villas and more</p>

        <form method="get" class="search-bar">
            <select name="countryId"
                    asp-items="@(ViewData["Countries"] as SelectList)"
                    class="form-select">
                <option value="">All destinations</option>
            </select>

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </form>
    </div>
</div>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">Available accommodations</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">+ Add accommodation</a>
        }
    </div>

    @{
        var accommodationsByCountry = Model
        .Where(a => a.Host != null && a.Host.Country != null)
        .GroupBy(a => a.Host.Country.Name)
        .OrderBy(g => g.Key);
    }

    @foreach (var countryGroup in accommodationsByCountry)
    {
        <h3 class="mt-4">@countryGroup.Key</h3>
        <div class="row">
            @foreach (var item in countryGroup)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 p-2">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">@item.Description</p>
                            <p class="text-muted">@item.Category</p>
                            <p class="price">
                                <strong>€@item.PricePerNight <span>/ night </span></strong>
                            </p>
                            <p class="host">Host: <strong>@item.Host.FullName</strong></p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Details</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>

                                        <button type="button" class="btn btn-danger btn-sm"
                                        onclick="if(confirm('Are you sure?')) { document.getElementById('delete-form-@item.Id').submit(); }">
                                            Delete
                                        </button>
                                    </div>
                                }
                                <div class="d-flex gap-1">

                                    <a asp-action="AddToCart" asp-route-id="@item.Id" class="btn btn-success btn-sm">Reserve</a>

                                    <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:none;">
                                        @Html.AntiForgeryToken()
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
