@model Booking.Domain.DomainModels.Accommodation

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Accommodation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PricePerNight" class="control-label">Price Per Night</label>
                <input asp-for="PricePerNight" class="form-control" />
                <span asp-validation-for="PricePerNight" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Select Image from Folder</label>

                <select name="ImageUrl" class="form-control">
                    @foreach (var img in (List<string>)ViewData["Images"])
                    {
                        <option value="@img" selected="@(Model.ImageUrl == img)">
                            @System.IO.Path.GetFileName(img)
                        </option>
                    }
                </select>
            </div>
            <div class="form-group mt-2">
                <label>Preview</label><br />
                <img id="preview"
                     src="@Model.ImageUrl"
                     class="img-fluid"
                     style="max-width:200px;" />
            </div>
            <script>
                document.querySelector('select[name="ImageUrl"]').addEventListener('change', function () {
                    document.getElementById('preview').src = this.value;
                });
            </script>
            <div class="form-group">
                <label asp-for="Category"></label>
                <select asp-for="Category" class="form-control" asp-items="@(ViewData["Category"] as IEnumerable<SelectListItem>)">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HostId">Host</label>
                <select asp-for="HostId" class="form-control" asp-items="@(ViewData["HostId"] as SelectList)">
                    <option value="">-- Select Host --</option>
                </select>
                <span asp-validation-for="HostId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary mt-2">Save</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary mt-1">← Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
