
@{
    ViewData["Title"] = "Reservation Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Reservation

<h2>Reservation Details</h2>
<hr />

<div class="mb-3">
    <strong>Full Name</strong> @Model.User.FirstName @Model.User.LastName
</div>
<div class="mb-3">
    <strong>Email</strong> @Model.User.Email
</div>
<div class="mb-3">
    <strong>Status:</strong>
    @if (Model.Status == ReservationStatus.Confirmed)
    {
        <span class="badge bg-success">Confirmed</span>
    }
    else
    {
        <span class="badge bg-danger">Cancelled</span>
    }
</div>

<div class="mb-3">
    <strong>Total Price:</strong> @Model.TotalPrice.ToString("0") €
</div>

<h4>Accommodations</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Accommodation</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Nights</th>
            <th>Price / Night</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var acc in Model.AccommodationInReservations)
        {
            <tr>
                <td>@acc.Accommodation?.Name</td>
                <td>@acc.FromDate.ToString("dd/MM/yyyy")</td>
                <td>@acc.ToDate.ToString("dd/MM/yyyy")</td>
                <td>@((acc.ToDate - acc.FromDate).Days)</td>
                <td>@acc.Accommodation?.PricePerNight.ToString("0.00") €</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">← Back to Reservations</a>
</div>