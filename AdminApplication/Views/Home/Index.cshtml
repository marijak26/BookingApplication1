@{
    ViewData["Title"] = "Admin Dashboard";
}
@model List<Reservation>

<h2>Admin Dashboard - All Reservations</h2>

<table class="table table-bordered mt-4">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">First Name</th>
            <th scope="col">Last Name</th>
            <th scope="col">Email</th>
            <th scope="col">Total Price</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            for (int i = 0; i < Model.Count; i++)
            {
                var reservation = Model[i];
                <tr>
                    <th scope="row">@(i + 1)</th>
                    <td>@reservation.User.FirstName</td>
                    <td>@reservation.User.LastName</td>
                    <td>@reservation.User.Email</td>
                    <td>@reservation.TotalPrice.ToString("0") €</td>
                    <td>
                        @if (reservation.Status == ReservationStatus.Confirmed)
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@reservation.Id">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No reservations found.</td>
            </tr>
        }
    </tbody>
</table>