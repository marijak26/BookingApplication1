@using Microsoft.AspNetCore.Http

<ul class="navbar-nav">
    @{
        var token = Context.Session.GetString("JWToken");
    }
    @if (!string.IsNullOrEmpty(token))
    {
        <li class="nav-item">
            <form asp-controller="AdminAuth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="AdminAuth" asp-action="Login">Login</a>
        </li>
    }
</ul>
